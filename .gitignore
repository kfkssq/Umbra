# Unreal Engine generated directories (project and plugins)
**/Binaries/
**/DerivedDataCache/
**/Intermediate/
**/Saved/

# Local backups and generated upgrade reports
/Backup/
/UpgradeLog*.htm
/UpgradeLog*.xml

# Visual Studio / Rider / VS Code user data
/.vs/
/.idea/
/.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.VC.db
*.VC.opendb
*.opensdf
*.sdf

# Generated IDE and Unreal project files
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.xcodeproj
*.xcworkspace
*.code-workspace

# Local build artifacts and diagnostics
*.log
*.pdb
*.obj
*.ipch
*.tmp
*.temp
*.bak
*.old
*.cache

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Keep Content tracked. Unreal binary assets are handled by Git LFS in
# .gitattributes; do not ignore *.uasset or *.umap here.

# Paragon Minions FX are kept locally but excluded from source control.
/Content/ParagonMinions/FX/

# Art source files (kept outside repo)
*.psd

# Local Python tooling caches
__pycache__/
*.pyc

# Equipment import: local staging assets, not production equipment.
/Content/EquipmentImport/Staging/
/Content/Items/Tests/PipelineM5/

# Reproducible M5 fixtures (regenerate with generate_samples.py).
/Scripts/EquipmentPipeline/Source/
/Scripts/EquipmentPipeline/samples.json

# Machine-specific paths; keep general examples, rules and test code tracked.
/Scripts/EquipmentImport/*.local.json
# Despite its historical name, this file contains this machine's actual paths.
/Scripts/EquipmentImport/item_catalog.local.example.json

# Material index helper build output; sources and project file stay tracked.
/Scripts/EquipmentImport/MaterialIndexTool/bin/
/Scripts/EquipmentImport/MaterialIndexTool/obj/
# Extraction caches, reports, previews and material indexes already live in
# Saved/ and are excluded by the generated-directory rule above.
